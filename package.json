    "eslint": "*",
    "eslint-config-next": "*",
    "eslint-config-prettier": "*",
    "eslint-plugin-tailwindcss": "*",
    "husky": "*",
    "jest": "*",
    "jest-environment-jsdom": "*",
    "postcss": "*",
    "prettier": "*",
    "tailwind-merge": "*",
    "tailwindcss": "*",
    "tailwindcss-animate": "*",
    "ts-node": "*",
    "typescript": "*"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
